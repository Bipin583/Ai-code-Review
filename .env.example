# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Anthropic Messages API (or compatible gateway)
ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token
ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_MODEL=gpt-5.6-sol
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_MAX_RETRIES=2

# Review controls (0 reviews every eligible file; positive values set a cap)
MAX_FILES_PER_REVIEW=0
MAX_DIFF_CHARS=12000
MAX_INLINE_COMMENTS=25
REVIEW_FILE_EXTENSIONS=.py

# Database
DATABASE_URL=sqlite:///./data/reviewbot.db

# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=*
